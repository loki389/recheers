PORT=3000

# 开发模式默认会在 /api/auth/sms/send 响应里返回 devCode，方便本地演示。
# 生产环境建议设置为 false，并配置 SMS_PROVIDER_URL。
SMS_DEV_MODE=true

# 可选：你的后端短信网关地址。server.js 会向它 POST：
# { "phone": "手机号", "code": "验证码", "template": "login" }
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_TEMPLATE_ID=login

# 可选：AI 调酒助手后端代理。二选一即可。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
